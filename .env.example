# Mechx4 Backend Environment Variables (.env.example)

# TiDB Cloud / Database Configuration
# Host: gateway01.ap-northeast-1.prod.aws.tidbcloud.com
# Port: 4000
# User: 3KQW41Z7XRUm1xM.root
# Default DB: sys (or mechx4)
SPRING_DATASOURCE_URL=jdbc:mysql://gateway01.ap-northeast-1.prod.aws.tidbcloud.com:4000/sys?sslMode=VERIFY_IDENTITY&enabledTLSProtocols=TLSv1.2,TLSv1.3
SPRING_DATASOURCE_USERNAME=3KQW41Z7XRUm1xM.root
DB_PASSWORD=your_tidb_password_here
SPRING_DATASOURCE_PASSWORD=your_tidb_password_here

# Active Spring Profile (prod | dev | test)
SPRING_PROFILES_ACTIVE=prod

# Server Port
PORT=8080

# JWT Secret (Must be at least 32 characters long)
MECHX4_JWT_SECRET=your_secure_random_jwt_secret_at_least_32_characters_long_here
NERLOGIX_JWT_SECRET=your_secure_random_jwt_secret_at_least_32_characters_long_here

# CORS Allowed Origins (Comma-separated)
MECHX4_CORS_ALLOWED_ORIGINS=https://mechx4-frontend.vercel.app,http://localhost:5173,http://localhost:8080
NERLOGIX_CORS_ALLOWED_ORIGINS=https://mechx4-frontend.vercel.app,http://localhost:5173,http://localhost:8080

# Uploads directory
MECHX4_UPLOADS_DIR=./uploads

# Weather & Simulation settings
MECHX4_WEATHER_AUTO_FETCH=true
MECHX4_SIMULATION_ENABLED=false
MECHX4_SIMULATION_TICK_MS=5000
